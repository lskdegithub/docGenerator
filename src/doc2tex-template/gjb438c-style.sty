% =================================================================
% 表格行间距设置
% =================================================================
% 定义表格行间距倍数（设置为1.0，使用默认表格行间距）
\newcommand{\tablearraystretch}{1.0}
% 应用表格行间距的辅助命令
\newcommand{\settablespacing}{\renewcommand{\arraystretch}{\tablearraystretch}\SeqInit\sloppy\emergencystretch=2em\relax\hyphenpenalty=10000\exhyphenpenalty=10000}
% 重置表格行间距
\newcommand{\resettablespacing}{\renewcommand{\arraystretch}{1.0}}

% =================================================================
% 标题格式设置（1-5级标题）
% =================================================================

\newlength{\GjbHeadingBeforeSkip}
\setlength{\GjbHeadingBeforeSkip}{9pt}
\newlength{\GjbHeadingAfterSkip}
\setlength{\GjbHeadingAfterSkip}{6pt}
\newlength{\GjbCaptionBeforeSkip}
\setlength{\GjbCaptionBeforeSkip}{3pt}
\newlength{\GjbCaptionAfterSkip}
\setlength{\GjbCaptionAfterSkip}{6pt}

\setcounter{secnumdepth}{6}
\setcounter{tocdepth}{6}

% 1级标题：五号宋体加粗，段前段后6pt
\titleformat{\section}
  {\wuhao\bfseries}
  {\thesection}
  {1em}
  {}
\titlespacing*{\section}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

% 2级标题：五号宋体加粗，段前段后6pt
\titleformat{\subsection}
  {\wuhao\bfseries}
  {\thesubsection}
  {1em}
  {}
\titlespacing*{\subsection}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

% 3级标题：五号宋体加粗，段前段后6pt
\titleformat{\subsubsection}
  {\wuhao\bfseries}
  {\thesubsubsection}
  {1em}
  {}
\titlespacing*{\subsubsection}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

% 4级标题：五号宋体加粗，段前段后6pt
\titleformat{\paragraph}[block]
  {\wuhao\bfseries}
  {\theparagraph}
  {1em}
  {}
\titlespacing*{\paragraph}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

% 5级标题：五号宋体加粗，段前段后6pt
\titleformat{\subparagraph}[block]
  {\wuhao\bfseries}
  {\thesubparagraph}
  {1em}
  {}
\titlespacing*{\subparagraph}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

\titleclass{\subsubparagraph}{straight}[\subparagraph]
\newcounter{subsubparagraph}[subparagraph]
\renewcommand\thesubsubparagraph{\thesubparagraph.\arabic{subsubparagraph}}
\titleformat{\subsubparagraph}[block]
  {\wuhao\bfseries}
  {\thesubsubparagraph}
  {1em}
  {}
\titlespacing*{\subsubparagraph}{0pt}{\GjbHeadingBeforeSkip}{\GjbHeadingAfterSkip}

% =================================================================
% 辅助命令
% =================================================================

% 统一的GJB章节标题命令（test_plan和test_detail通用）
% 用法: \GjbSection{3. 软件测试环境} 或 \GjbSection{软件测试环境}
% 悬挂缩进：换行时与标题内容对齐，而非与编号对齐
\newcommand{\GjbSection}[1]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1. }\hangindent=\wd0\hangafter=1
  #1\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  \addcontentsline{toc}{section}{#1}%
}

\newcommand{\GjbSubsection}[1]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1.1. }\hangindent=\wd0\hangafter=1
  #1\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  \addcontentsline{toc}{subsection}{#1}%
}

\newcommand{\GjbSubsubsection}[1]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1.1.1. }\hangindent=\wd0\hangafter=1
  #1\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  \addcontentsline{toc}{subsubsection}{#1}%
}

\newcommand{\GjbParagraph}[2][]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1.1.1.1. }\hangindent=\wd0\hangafter=1
  #2\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  \addcontentsline{toc}{paragraph}{\if\relax\detokenize{#1}\relax#2\else#1\fi}%
}

\newcommand{\GjbSubparagraph}[2][]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1.1.1.1.1. }\hangindent=\wd0\hangafter=1
  #2\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  \addcontentsline{toc}{subparagraph}{\if\relax\detokenize{#1}\relax#2\else#1\fi}%
}

\newcommand{\GjbSubsubparagraph}[1]{%
  \par\noindent\addvspace{\GjbHeadingBeforeSkip}%
  \begingroup
  \wuhao\bfseries
  \setbox0=\hbox{1.1.1.1.1.1. }\hangindent=\wd0\hangafter=1
  #1\par
  \endgroup
  \par\addvspace{\GjbHeadingAfterSkip}%
  % 不添加到目录中，避免目录层级过深
}

% 表格标准格式（防止分页）
% 用法: \StandardTable{标题}{列格式}{内容}
\newcommand{\StandardTable}[3]{%
  \begin{table}[H]
  \centering
  \vspace{\GjbCaptionBeforeSkip}
  {\wuhaohei #1}
  \vspace{\GjbCaptionAfterSkip}
  {\settablespacing
  \begin{tblr}[theme=gjb]{colspec={#2},hlines={0.2pt,solid,black},vlines={0.2pt,solid,black},leftsep=3pt,rightsep=3pt,rows={valign=t}}
  #3
  \end{tblr}
  }
  \end{table}
}

% 带灰表头的表格行
% 用法: \GrayHeaderRow{列数}{内容1}{内容2}{...}
\newcommand{\GrayHeaderRow}[2]{%
  \hline
  \rowcolor{gray!20}%
  #2%
  \\%
  \hline%
}

% 普通表格行
% 用法: \NormalRow{列数}{内容1}{内容2}{...}
\newcommand{\NormalRow}[2]{%
  #2%
  \\%
  \hline%
}

% =================================================================
% 数据驱动表格格式（用于自动生成章节）
% =================================================================

% 表格题注（居中，五号黑体，前后各6pt间距）
% 用法: \DataTableCaption{表编号}{标题}
\newcommand{\DataTableCaption}[2]{%
  \vspace{\GjbCaptionBeforeSkip}%
  \centerline{\wuhaohei 表 #1 #2}%
  \vspace{\GjbCaptionAfterSkip}%
}

% 表头单元格（小五号黑体，居中）
% 用法: \TableHeaderCell{内容}
\newcommand{\TableHeaderCell}[1]{%
  \xiaowuhei #1%
}

% 表单/字段类表格的 Key 单元格（小五号黑体）
% 用法: \TableKeyCell{内容}
\newcommand{\TableKeyCell}[1]{%
  {\xiaowuhei #1}%
}

% 表单/字段类表格的 Identifier 值
% 用法: \TableIdentifier{内容}
\newcommand{\TableIdentifier}[1]{%
  {\xiaowu\ttfamily\raggedright\hspace{0pt}#1}%
}

\ExplSyntaxOn
\tl_new:N \l__gjb_planitem_caption_tl
\tl_new:N \l__gjb_planitem_label_tl
\tl_new:N \l__gjb_planitem_name_tl
\tl_new:N \l__gjb_planitem_ident_tl
\tl_new:N \l__gjb_planitem_req_tl
\tl_new:N \l__gjb_planitem_strategy_tl
\tl_new:N \l__gjb_planitem_method_tl
\tl_new:N \l__gjb_planitem_assume_tl
\tl_new:N \l__gjb_planitem_constraint_tl
\tl_new:N \l__gjb_planitem_priority_tl
\tl_new:N \l__gjb_planitem_term_tl
\tl_new:N \l__gjb_planitem_trace_tl
\keys_define:nn { gjb/planitem }
  {
    caption .tl_set:N = \l__gjb_planitem_caption_tl,
    label .tl_set:N = \l__gjb_planitem_label_tl,
    name .tl_set:N = \l__gjb_planitem_name_tl,
    ident .tl_set:N = \l__gjb_planitem_ident_tl,
    req .tl_set:N = \l__gjb_planitem_req_tl,
    strategy .tl_set:N = \l__gjb_planitem_strategy_tl,
    method .tl_set:N = \l__gjb_planitem_method_tl,
    assume .tl_set:N = \l__gjb_planitem_assume_tl,
    constraint .tl_set:N = \l__gjb_planitem_constraint_tl,
    priority .tl_set:N = \l__gjb_planitem_priority_tl,
    term .tl_set:N = \l__gjb_planitem_term_tl,
    trace .tl_set:N = \l__gjb_planitem_trace_tl,
  }
\cs_new_protected:Npn \__gjb_planitem_table:
  {
    {\settablespacing
    \begin{longtblr}[theme=gjbNoHead,caption={\l__gjb_planitem_caption_tl},label={\l__gjb_planitem_label_tl}]{
      colspec={|p{2.3cm}|p{6cm}|p{0.7cm}|p{5.5cm}|},
      hlines={wd=\GjbTableRuleWd,fg=\GjbTableRuleColor},
    }
    \TableKeyCell{测试项名称} & \SetCell{wd=6cm,valign=t}{\l__gjb_planitem_name_tl} & \TableKeyCell{标识} & \SetCell{wd=5.5cm,valign=t}{\TableIdentifier{\l__gjb_planitem_ident_tl}} \\
    \TableKeyCell{测试要求} & \SetCell[c=3]{wd=13cm,valign=t}{\l__gjb_planitem_req_tl} && \\
    \TableKeyCell{测试策略与方法} & \SetCell[c=3]{wd=13cm,valign=t}{测试策略：\l__gjb_planitem_strategy_tl\newline 测试方法：\l__gjb_planitem_method_tl} && \\
    \TableKeyCell{假设与约束} & \SetCell[c=3]{wd=13cm,valign=t}{假设：\l__gjb_planitem_assume_tl\newline 约束：\l__gjb_planitem_constraint_tl} && \\
    \TableKeyCell{优先级} & \SetCell[c=3]{wd=13cm,valign=t}{\l__gjb_planitem_priority_tl} && \\
    \TableKeyCell{测试终止条件} & \SetCell[c=3]{wd=13cm,valign=t}{\l__gjb_planitem_term_tl} && \\
    \TableKeyCell{追踪关系} & \SetCell[c=3]{wd=13cm,valign=t}{\l__gjb_planitem_trace_tl} && \\
    \end{longtblr}
    }
    \vspace{0pt}
  }
\NewDocumentCommand{\GjbPlanItemTable}{ m }
  {
    \keys_set:nn { gjb/planitem } { #1 }
    \__gjb_planitem_table:
  }
\ExplSyntaxOff

% 普通表格内容单元格（小五号宋体，固定宽度parbox）
% 用法: \TableCell{宽度}{内容}
\newcommand{\TableCell}[2]{%
  {\xiaowu #2}%
}

% 标识列单元格（小五号宋体，固定宽度parbox，等宽字体）
% 用法: \TableCellIdentifier{宽度}{内容}
\newcommand{\TableCellIdentifier}[2]{%
  {\xiaowu\ttfamily\raggedright\hspace{0pt}#2}%
}
\ExplSyntaxOn
\int_new:N \g__gjb_tabseq_int
\cs_new_protected:Npn \SeqInit { \int_gzero:N \g__gjb_tabseq_int }
\cs_new_protected:Npn \Seq
  {
    \cs_if_exist:NTF \l__tblr_measuring_bool
      {
        \bool_if:NTF \l__tblr_measuring_bool
          { \xiaowu 1 }
          {
            \int_gincr:N \g__gjb_tabseq_int
            \xiaowu \int_to_arabic:n { \g__gjb_tabseq_int }
          }
      }
      {
        \int_gincr:N \g__gjb_tabseq_int
        \xiaowu \int_to_arabic:n { \g__gjb_tabseq_int }
      }
  }
\ExplSyntaxOff

\AddToHook{env/longtblr/begin}{\SeqInit}
\AddToHook{env/talltblr/begin}{\SeqInit}
\AddToHook{env/tblr/begin}{\SeqInit}

% =================================================================
% 完整的表格环境封装
% =================================================================

% =================================================================
% Tabularray longtblr 统一样式（用于表2）
% =================================================================
\DefTblrTemplate{caption-tag}{gjb}{\wuhaohei 表~\thetable}
\DefTblrTemplate{caption-sep}{gjb}{\quad}
\DefTblrTemplate{caption-text}{gjb}{\wuhaohei \InsertTblrText{caption}}
\DefTblrTemplate{caption}{gjb}{%
  \vspace{3pt}%
  \centerline{%
    {\color{black}%
      \UseTblrTemplate{caption-tag}{gjb}%
      \UseTblrTemplate{caption-sep}{gjb}%
      \UseTblrTemplate{caption-text}{gjb}%
    }%
  }%
  \vspace{6pt}%
}
\DefTblrTemplate{contfoot-text}{default}{}
\DefTblrTemplate{conthead-text}{default}{}
\DefTblrTemplate{capcont}{default}{}

\NewTblrTheme{gjb}{
  \SetTblrStyle{head}{fg=black,font=\xiaowuhei,halign=c}
  \SetTblrStyle{foot}{font=\xiaowu}
  \SetTblrInner[tblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    row{1}={font=\xiaowuhei,halign=c,valign=m},
    rows={valign=t}
  }
  \SetTblrInner[longtblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    row{1}={font=\xiaowuhei,halign=c,valign=m},
    rows={valign=t}
  }
  \SetTblrInner[talltblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    row{1}={font=\xiaowuhei,halign=c,valign=m},
    rows={valign=t}
  }
  \SetTblrTemplate{caption}{gjb}
  \SetTblrTemplate{caption-tag}{gjb}
  \SetTblrTemplate{caption-sep}{gjb}
  \SetTblrTemplate{caption-text}{gjb}
}

\NewTblrTheme{gjbNoHead}{
  \SetTblrStyle{head}{fg=black,font=\xiaowuhei,halign=c}
  \SetTblrStyle{foot}{font=\xiaowu}
  \SetTblrInner[tblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    rows={valign=t}
  }
  \SetTblrInner[longtblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    rows={valign=t}
  }
  \SetTblrInner[talltblr]{
    width=\linewidth,
    colsep=\GjbTableColSep,
    cells={font=\xiaowu},
    rows={valign=t}
  }
  \SetTblrTemplate{caption}{gjb}
  \SetTblrTemplate{caption-tag}{gjb}
  \SetTblrTemplate{caption-sep}{gjb}
  \SetTblrTemplate{caption-text}{gjb}
}
